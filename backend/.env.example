# ── Hinglish backend config ───────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env.

# ── Database ─────────────────────────────────────────────────────────────────
# Password only. The username, cluster host and database name live in db.js.
MONGODB_PASSWORD=

# ── Gemini ───────────────────────────────────────────────────────────────────
# Google AI Studio key(s). Comma-separate several to spread rate limits;
# the client rotates through them.
AISTUDIO_KEY=

# The model used to read the video. MUST be video-capable.
# Kept in env on purpose: model names move faster than deploys, so a rename is a
# config change rather than a code change.
#
# NOTE: the Gemini docs reference "gemini-3.8-flash", which does NOT exist on a
# current AI Studio key. Verified working: gemini-3.5-flash. To see what your key
# can actually reach:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$AISTUDIO_KEY" | grep -o '"models/[^"]*"'
GEMINI_VIDEO_MODEL=gemini-3.5-flash

# Token prices in USD per MILLION tokens, used to record what each transcript
# actually cost (Transcript.usage). Update when Google changes them — these are
# only for our own accounting, they don't affect what gets billed.
# gemini-3.5-flash as of Sep 2026:
GEMINI_USD_PER_M_INPUT=1.50
GEMINI_USD_PER_M_OUTPUT=9.00

# ── Auth ─────────────────────────────────────────────────────────────────────
# console.cloud.google.com > Credentials > OAuth 2.0 Client ID (Web application).
# The SAME client id must be set as REACT_APP_GOOGLE_CLIENT_ID in the frontend,
# or the ID-token audience check will reject every login.
GOOGLE_CLIENT_ID=

# Signing key for our session JWT. Any long random string.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cookie domain. Leave BLANK for localhost — a domain of "localhost" is invalid
# and the browser silently drops the cookie. Set to .chomske.com in production.
COOKIE_DOMAIN=

# ── Server ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://chomske.com,https://www.chomske.com
NODE_ENV=development
PORT=8001

# How many transcripts one account may run per day. Reading a video is the entire
# cost of this product, so this is the spend cap — keep it deliberate.
DAILY_TRANSCRIBE_LIMIT=10

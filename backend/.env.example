# ── Hinglish backend config ───────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env.

# ── Database ─────────────────────────────────────────────────────────────────
# Password only. The username, cluster host and database name live in db.js.
MONGODB_PASSWORD=

# Full connection string, overriding everything above. Leave EMPTY in production.
# It exists so a migration can be rehearsed against a restored dump before it is
# run with --apply on the live cluster:
#   MONGODB_URI=mongodb://localhost:27017/hinglish node scripts/migrateProfiles.js
# MONGODB_URI=

# ── Gemini ───────────────────────────────────────────────────────────────────
# Which Google serves the models: "aistudio" or "vertex".
#
# Everything about the difference lives in services/ai/provider.js and nothing
# else in the codebase knows which one is in use, so moving between them is this
# one line and a restart.
#
#   aistudio  authenticates with AISTUDIO_KEY. Quota is PER KEY, so several keys
#             is several ceilings and the provider rotates through them.
#   vertex    authenticates with Application Default Credentials — the service
#             account on the VM, or GOOGLE_APPLICATION_CREDENTIALS pointing at a
#             key file locally. No key, and no key rotation: quota belongs to the
#             PROJECT, per region. VERTEX_LOCATION is the lever instead.
#
# On Vertex, before anything works: enable the Vertex AI API on the project, give
# the service account roles/aiplatform.user, and make sure the VM's access scope
# includes cloud-platform (IAM alone is not enough, and changing it needs a stop).
#
# Since 2026-09-25 (paid AI Studio credits): an AI Studio key below MEANS AI
# Studio — leave this unset. Set it only to force a choice: "vertex" uses the
# Cloud project whatever keys are set; "aistudio" insists on a key.
# GEMINI_PROVIDER=

# Google AI Studio key(s). Comma-separate several to spread rate limits; the
# provider rotates through them. GEMINI_API_KEY or GOOGLE_API_KEY (Google's own
# names) are read too, if this is empty.
AISTUDIO_KEY=

# ── Vertex ───────────────────────────────────────────────────────────────────
# Only read when GEMINI_PROVIDER=vertex. The project is picked up from the
# environment (GOOGLE_CLOUD_PROJECT, or the VM's metadata) when left empty.
# VERTEX_PROJECT=

# Region, or several comma-separated.
#
# ── THIS IS THE KEY POOL'S REPLACEMENT ───────────────────────────────────────
# Vertex grants quota per project PER REGION, so the same model in us-central1
# and europe-west4 draws on two separate allowances and listing both doubles the
# ceiling. One region is perfectly normal and means no rotation.
# VERTEX_LOCATION=us-central1

# ── How fast we are allowed to ask ───────────────────────────────────────────
# A budget we SET, not a limit we discover. Discovering it means sending
# requests until Google refuses, and every refusal costs a round trip plus a
# burst that puts the next window in debt.
#
# Set it BELOW the quota actually granted — the Quotas page under Vertex AI says
# what that is, and a new project is often far lower than the documented default
# until quota is requested. A testing project capped at one request a minute is
# a supported configuration: GEMINI_RPM=1 makes a three hundred frame pass take
# five hours and FINISH, rather than failing in four seconds.
#
# Requests a minute, per bucket (per key on AI Studio, per region on Vertex).
# Defaults: 600 on AI Studio (paid tier), 60 on Vertex.
# GEMINI_RPM=600
# Burst allowed above that steady rate. Defaults: 60 on AI Studio, 10 on Vertex.
# GEMINI_BURST=60
# Simultaneous in-flight requests, across every caller in the process.
# Defaults: 16 on AI Studio, 4 on Vertex.
# GEMINI_CONCURRENCY=16
# Attempts per request, including the first.
# GEMINI_ATTEMPTS=5
# The longest one request may spend WAITING, across every wait it does. Twenty
# minutes, which sounds absurd until the quota is one a minute and four frames
# are queued in front of this one.
# GEMINI_MAX_WAIT_MS=1200000
# How long a 429 puts the whole bucket to sleep when the server named no delay.
# The server's own retryDelay always wins over this.
# GEMINI_COOLDOWN_MS=30000
#
# With Redis reachable the budget is SHARED across processes (hg:ai:* keys), so
# two workers cannot each spend the full allowance. Without it each process
# paces itself alone, which is correct but twice as fast as intended on two.

# ── Which model ──────────────────────────────────────────────────────────────
# All four default from the PROVIDER and need not be set:
#   vertex    gemini-2.5-flash
#   aistudio  gemini-3.5-flash
#
# ── WHY THE DEFAULT DEPENDS ON THE PROVIDER ──────────────────────────────────
# The two APIs do not serve the same catalogue, and — the part that costs an
# afternoon — being IN the catalogue is not the same as being callable. On a new
# Vertex project every 3.x model is listed in us-central1 and every one of them
# answers generateContent with:
#
#   404 "Publisher model ... was not found OR YOUR PROJECT DOES NOT HAVE ACCESS
#        TO IT"
#
# It is the second half. Verified callable on this project: gemini-2.5-flash,
# gemini-2.5-flash-lite, and gemini-2.5-pro (which refuses thinking_budget 0 and
# therefore costs more — the provider detects that and resends without it).
#
# To see what YOUR project can actually call, rather than what it can list:
#   node scripts/aiDoctor.js
#   node scripts/aiDoctor.js --regions=us-central1,us-east4,europe-west4
#
# GEMINI_MODEL sets all four at once; the specific ones below win over it.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEXT_MODEL=       steps, narration, the reviewer, scripts, news
# GEMINI_VISION_MODEL=     the studio's frame reading and the cross-check
# GEMINI_AUDIO_MODEL=      captions, transcription
# GEMINI_VIDEO_MODEL=      YouTube transcription. MUST be video-capable.

# Token prices in USD per MILLION tokens, used to record what each transcript
# actually cost (Transcript.usage). Update when Google changes them, these are
# only for our own accounting, they don't affect what gets billed.
# ── THESE MUST MATCH THE MODEL ACTUALLY IN USE ───────────────────────────────
# They are the rate for gemini-3.5-flash on AI Studio. A Vertex project running
# gemini-2.5-flash is on a different and considerably cheaper rate, so leaving
# them alone does not cost money — it OVER-records cost against what creators
# are charged, which is the number the credit ledger reasons about. Check the
# Vertex pricing page for whichever model scripts/aiDoctor.js settled on.
GEMINI_USD_PER_M_INPUT=1.50
GEMINI_USD_PER_M_OUTPUT=9.00

# ── Auth ─────────────────────────────────────────────────────────────────────
# console.cloud.google.com > Credentials > OAuth 2.0 Client ID (Web application).
# The SAME client id must be set as REACT_APP_GOOGLE_CLIENT_ID in the frontend,
# or the ID-token audience check will reject every login.
GOOGLE_CLIENT_ID=

# Signing key for our session JWT. Any long random string.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cookie domain. Leave BLANK for localhost, a domain of "localhost" is invalid
# and the browser silently drops the cookie. Set to .tryclipo.com in production.
COOKIE_DOMAIN=

# ── Server ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4800,https://tryclipo.com,https://www.tryclipo.com,https://trylipi.online,https://www.trylipi.online
NODE_ENV=development
PORT=8001

# How many transcripts one account may run per day. Reading a video is the entire
# cost of this product, so this is the spend cap, keep it deliberate.
DAILY_TRANSCRIBE_LIMIT=10

# ── Voice + scripts ──────────────────────────────────────────────────────────
# Text model for voice analysis, news ranking and script writing. Does not need
# to be video-capable, so it can be cheaper than GEMINI_VIDEO_MODEL.
# GEMINI_TEXT_MODEL=gemini-3.5-flash

# Scripts per account per day. Far cheaper than a transcription (text in, text
# out) but not free, and this is the endpoint someone would hammer.
DAILY_SCRIPT_LIMIT=30

# How many of a creator's transcripts feed one voice profile. Past ~8 the extra
# signal is small and the input cost is not. Only a head/middle/tail sample of
# each is sent, so long videos cost the same to analyse as Shorts.
# VOICE_MAX_TRANSCRIPTS=8

# Target script length. Roughly 60-90 seconds spoken.
# SCRIPT_TARGET_WORDS=180-260

# Thinking budget for script writing ONLY, in tokens. Off by default, matching
# the measured finding for transcription (thinking billed at the output rate for
# no quality gain). Writing is the one place it might genuinely pay, set a budget
# and compare two scripts side by side before leaving it on.
# GEMINI_SCRIPT_THINKING=0

# ── YouTube Data API v3: video details ───────────────────────────────────────
# Duration, title, thumbnail and channel for every video that enters the
# product. This REPLACED apidirect's /v1/youtube/video, which cost $0.005 a call.
#
#   videos.list = 1 quota unit, against 10,000 units/day free, and it takes up
#   to FIFTY ids per request for that same one unit.
#
# At our volumes this is effectively free: MAX_VOICE_VIDEOS=5 means a complete
# voice profile costs 5 units, so the daily allowance covers ~2,000 of them.
# The practical ceiling is roughly 4,000 active creators, and caching video
# details (duration and title never change) pushes it well past that.
#
# ⚠️ NEVER use search.list. It costs 100 units AND has its own separate ceiling
# of 100 searches/day, so one careless loop burns the entire daily allowance.
#
# HOW TO MINT THE KEY. No OAuth, no consent screen, no verification, no card:
# public video metadata needs nobody's permission. The audit Google documents
# applies only to quota EXTENSION requests, which we will never need.
#   1. console.cloud.google.com → APIs & Services → Library
#      → "YouTube Data API v3" → Enable. Use the SAME project as GOOGLE_CLIENT_ID.
#   2. Credentials → Create credentials → API key
#   3. API restrictions → YouTube Data API v3 ONLY. This is the important one:
#      an unrestricted key that leaks also reaches the Gemini surface, which is
#      where the real money is. Restricted, a leak can only burn a quota that
#      resets at midnight Pacific.
#   4. Application restrictions → IP addresses, set to the VM's EGRESS ip
#      (`curl -s https://api.ipify.org` ON the server; behind Cloud NAT that is
#      the NAT ip, not 10.3.x.x). Do NOT pick "Websites": that validates the
#      Referer header, which a server-side fetch does not send, so every call
#      would 403.
#
# Backend only. This must never become a REACT_APP_* var: CRA inlines those
# into the bundle at build time. Unlike GOOGLE_CLIENT_ID, this one is a
# spendable credential.
API_KEY_YOUTUBE=

# Whether a FAILED YouTube lookup may fall back to apidirect at $0.005 a call.
# Default true. The fallback exists because the length gate fails closed (see
# the warning below), so a single provider having a bad hour would otherwise
# take "add a video" down with it. Every use logs a warning naming the reason,
# so a migration that quietly stops being free is visible in the logs.
# Set false to make YouTube the only provider and let the gate refuse instead.
# VIDEO_META_FALLBACK=true

# ── apidirect.io ─────────────────────────────────────────────────────────────
# Its news endpoint fed the news collector, which has been removed.
#
# GET /v1/youtube/video is no longer the primary video lookup, see
# API_KEY_YOUTUBE above. It remains wired as the fallback only. Two reasons it
# was replaced rather than kept: cost, and correctness. It was returning
# NORMALISED titles, not real ones, translating a Telugu title into English and
# dropping the creator's own emoji and hashtags.
#
# Keys can also live in the ApidirectAPIs collection (field: apidirect_key), which
# is how to add more without a deploy. This env value is always a candidate too.
# A key that hits a billing state or a spending cap is cooled for an hour, has the
# reason written to its row, and is rotated past, never deleted.
APIDIRECT_API_KEY=

# In-flight calls per (endpoint, key). apidirect's documented ceiling is 3.
# APIDIRECT_PER_KEY_CONCURRENCY=2

# ⚠️ WITH NO WORKING METADATA PROVIDER, ADDING A VIDEO IS REFUSED. It does not
# fall through to Gemini. The length check is the only thing standing between an
# arbitrary YouTube URL and the most expensive call this product makes, so a
# length that cannot be verified is not eligible for voice analysis. Users see
# "we can't check video lengths right now". It recovers the moment a key works
# again.
#
# "No working provider" now means BOTH API_KEY_YOUTUBE and this key are failing,
# which is the whole point of keeping the fallback wired: one bad hour at Google
# no longer takes the product's main action down with it.
#
# Gemini is NEVER used to find a video's duration: that is a one-quota-unit
# question answered by videos.list, not a transcription of the whole video to
# discover it was 40 minutes long.

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Credits are sold in one-time packs, in INR, so Razorpay surfaces UPI. Card-only
# checkout in a market that runs on UPI is a checkout most people abandon.
#
# Dashboard → Settings → API Keys. The SECRET is what signs and verifies every
# payment: it must never reach the frontend, and rotating it invalidates
# in-flight verifications, so rotate when nobody is mid-checkout.
#
# Without these the server still boots and everything except buying works,
# GET /billing/packs reports configured:false and the UI hides the buy button.
# Use rzp_test_* keys against Razorpay's test mode before going live.
RZP_KEY_ID=
RZP_KEY_SECRET=

# Prices, pack sizes and the credits-per-second rule are NOT env vars, they
# live in services/creditPricing.js, which is the single source the API, the
# pricing page and the charging path all read. A price in two places disagrees
# eventually, and the version the customer saw is the one they hold you to.

# ── Operations ───────────────────────────────────────────────────────────────
# Who may read GET /stats/apidirect (which key is working, which is exhausted).
# Comma-separated addresses. EMPTY MEANS NOBODY, the endpoint 404s for everyone,
# including signed-in users, so it can never be left open by omission.
ADMIN_EMAILS=

# ── Profiles ─────────────────────────────────────────────────────────────────
# A profile is ONE CHANNEL's workspace: its own categories, its own single
# voice, that voice's videos, and the scripts written for it. Someone running
# three YouTube channels in three niches keeps three profiles.
#
# How many videos define one voice. Counted PER PROFILE, not per account.
MAX_VOICE_VIDEOS=5

# How many channels one account may keep.
#
# This is a spend ceiling, not a tidiness rule: every profile carries its own
# MAX_VOICE_VIDEOS slots, and reading a video is the one genuinely expensive
# thing this product does. DAILY_TRANSCRIBE_LIMIT caps the rate; this caps the
# total. Raising both at once multiplies what a single account can cost.
# MAX_PROFILES=5

# NOTE: the per-profile category cap is MAX_CATEGORIES in services/categories.js.
# It limits what ONE channel watches. The union across an account's profiles is
# deliberately uncapped, it is what the collector schedules off, and truncating
# it silently stops collecting a category the user actually picked.

# ── The two voice lanes ──────────────────────────────────────────────────────
# MAX_VIDEO_SECONDS is GONE. It was one ceiling for one voice; there are now two
# voices, and a video is sorted into one of them by its length. See
# services/voiceLanes.js for the full argument. Setting the old name has no
# effect, so remove it from any deployed .env rather than leaving it to mislead.
#
# Short lane: one subject, start to finish. Trains the voice used for scripts
# under VOICE_LANE_SPLIT_SECONDS. Deliberately ABOVE the split: this bounds what
# we learn from, the split bounds what we produce, and a single-subject video a
# little longer than the longest script we write still demonstrates exactly what
# this lane needs.
#
# ⚠️ THIS MUST EQUAL VOICE_LONG_MIN_SECONDS. Not "stay below" it, EQUAL it.
# services/voiceLanes.js tests this one inclusively (<=) and the long one
# exclusively (>), which is what lets the two lanes share a number without a
# video ever landing in both. Setting them apart opens a band that laneForVideo
# refuses, and that refusal is silent from the creator's side: a video inside
# the band is simply rejected with a message naming two ranges it falls between.
#
# This file previously shipped 150 here against 180 below, which is exactly that
# bug: a thirty second dead zone from 2:30 to 3:00. Both default to 180 in code.
VOICE_SHORT_MAX_SECONDS=180

# Long lane: several products or stories in sequence. Trains the voice used for
# scripts at or over the split. Three minutes rather than two, because a 2:30
# video is usually still ONE topic and so demonstrates nothing about how this
# creator moves between stories, which is the only reason this lane exists.
VOICE_LONG_MIN_SECONDS=180

# There is NO gap between the two, and there must not be one. They hold the same
# number, tested inclusively from the short side and exclusively from the long,
# so every video from one second to VOICE_LONG_MAX_SECONDS lands in exactly one
# lane. See the warning on VOICE_SHORT_MAX_SECONDS above.

# Which lane writes a script of a given length.
VOICE_LANE_SPLIT_SECONDS=120

# How many long videos before the long lane will build at all. One long video
# shows one episode's running order, which a model will happily mistake for a
# rule; three is where a repeated habit separates from a one-off.
VOICE_LONG_MIN_VIDEOS=3

# How much of a long transcript's interior is sampled, and across how many
# slices. Split rather than taken as one block because story-to-story joins sit
# at item boundaries scattered through the video, and a single centre slice
# catches at most one of them by luck.
VOICE_LONG_MID_CHARS=750
VOICE_LONG_MID_SLICES=3

# ── Redis ────────────────────────────────────────────────────────────────────
# The host is hardcoded in backend/redis.js (10.3.176.99), the SAME Memorystore
# node betaFounderProduction uses. That module owns the only connection and every
# other file imports it, so these are overrides, not requirements.
#
# Because the instance is shared, every key this project writes carries an `hg:`
# prefix. Keep that up for anything new, or it can collide with the other
# project's keys and corrupt its counters with no local symptom.
# REDIS_HOST=10.3.176.99
# REDIS_PORT=6379
# REDIS_PASSWORD=       # only if the instance has AUTH enabled

# LOCAL DEVELOPMENT: set this. The IP is VPC-private, so off the VM it can never
# connect and ioredis retries forever, burying real errors. Requests work either
# way (limits fall back in-process), this just stops the log flood.
# REDIS_DISABLED=true

# ── TINYFISH: reading the actual articles a script is written from ───────────
# Page fetches are FREE. What is limited is requests per minute per key, so this
# pool exists to rotate and to be a polite consumer, not to control spend.
#
# Keys normally live in the `tinyfish_apis` collection (models/TinyfishAPIs.js)
# so they can be added without a deploy. This env value is an additional key,
# useful for local work.
TINYFISH_API_KEY=

# Requests per minute per key. Set under the published ceiling on purpose.
TINYFISH_RPM=15
TINYFISH_TIMEOUT_MS=45000
TINYFISH_RATE_COOLDOWN_MS=60000

# How much material a script is written from. A Reel makes one point and cannot
# use five articles; an eight minute explainer needs sections that each say
# something new. Reading is free, so these are set by what the length can use,
# not by what the API would allow.
SCRIPT_DEEP_READ_FROM_SECONDS=120
SCRIPT_SHORT_READ_SOURCES=3
SCRIPT_DEEP_READ_SOURCES=5
SCRIPT_SHORT_READ_CHARS=2500
SCRIPT_DEEP_READ_CHARS=3000

# How long a script will queue for TinyFish capacity before giving up and
# writing from snippets instead. Script generation is already polled, so nothing
# holds an HTTP request open while this waits.
TINYFISH_MAX_QUEUE_MS=120000

# Retries when every apidirect key is at its concurrency cap. A full pool is a
# queue, not a fault: four attempts on a doubling backoff is about six seconds.
APIDIRECT_BUSY_RETRIES=4

# ── IMPORT AND IDEA: material a creator brings themselves ────────────────────
# Discover writes from a ranked news story whose research the collector already
# paid for on its own clock. These two screens do not have that, so reading the
# material is part of the order, and two of the four inputs are not free:
#
#   pasted text   free. Input tokens, a few tenths of a cent.
#   web links     free. TinyFish costs nothing (see the block above).
#   a YouTube URL NOT free. Gemini reads the video, metered per second, and this
#                 is the most expensive call this product makes.
#   a lookup      not free. A model call plus a news fan-out, for one person.
#
# Everything free happens during POST /source/preview, BEFORE any credit moves,
# which is what lets the creator see "read 3 of 5, the FT blocked us" and decide
# with that in front of them. The video read is deferred until they have paid.

# Longest video Import will read, in seconds. Deliberately far above the voice
# lane ceilings above: those bound what a voice is LEARNED from. This is the
# STORY, and the videos creators want to cover, a press conference, a news
# segment, a podcast clip, are minutes long.
MAX_SOURCE_VIDEO_SECONDS=600

# Credits per 2-minute block of video, after the first 2 minutes which are free.
# A ten minute video therefore costs 24 credits to read, on top of the script.
# Rough calibration: Gemini bills ~263 tokens per second of video, so ten minutes
# is ~$0.24 of input at GEMINI_USD_PER_M_INPUT, and a credit sells for ~₹0.8.
VIDEO_READ_CREDITS=6

# Flat charge for "Look it up first" in Idea mode. Covers one planning call, a
# fan-out across the free news sources, and the larger writer prompt.
# NOT charged when the lookup finds nothing: the search runs during the free
# preview, so a miss is known before the order and simply never billed.
#
# When there is no coverage (an evergreen explainer has none, today or ever),
# Idea DRAFTS the content instead and the creator edits it before ordering. That
# draft uses GEMINI_TEXT_MODEL, is free, and has no env var of its own: it is a
# small call on a screen somebody is actively using, bounded by
# DAILY_SOURCE_PREVIEWS below. It is also the ONE place this product lets a
# model write from its own knowledge, and only because the creator reads and
# approves it before it becomes material. See services/ideaDraftService.js.
LOOKUP_CREDITS=10

# ⚠️ WATCH THIS ONE FIRST IF IMPORT GETS POPULAR.
# Videos one account may have READ per day. Separate from DAILY_SCRIPT_LIMIT
# because it guards something else: Gemini's free tier allows roughly EIGHT
# HOURS of YouTube per KEY per day, shared across every user we have. Twenty
# people reading a twenty-minute video each would exhaust it for everybody.
# Counts reads, not orders, a second script from a video already read is free.
DAILY_SOURCE_VIDEO_READS=10

# Previews one account may build per day. Generous, because pasting links,
# seeing what came back and adjusting is the normal way the screen gets used.
# A preview can still spend an apidirect metadata call and a lookup's planning
# call, so it is not unlimited.
DAILY_SOURCE_PREVIEWS=40

# How long prepared material is cached, in days. This is a cache of other
# people's content, not a record of the creator's work: the Script keeps the
# URLs, the brief and the finished text permanently. Its one functional job is
# that a second order from the same video does not re-buy the read.
SOURCE_TTL_DAYS=30

# Characters kept per pasted link. Matches SCRIPT_DEEP_READ_CHARS.
SOURCE_LINK_CHARS=3000

# The input ceilings (5 links, 6000 characters of pasted text, 2000 of brief)
# are NOT env vars. They live in services/creditPricing.js and are served to the
# browser by GET /source/limits, so the help text under each box and the server's
# own clamp can never drift apart.

# ── THE VIDEO EDITOR ─────────────────────────────────────────────────────────
# A creator uploads the video they recorded from a Clipo script. We find where
# they speak (ffmpeg, from the audio itself), ask Gemini what was said in each
# stretch, match that to the script line by line (retakes and ad-libs included),
# and lay out an edit with the B-roll slots from the shoot pack. They tweak it
# and export an MP4 with captions. See services/edit/.
#
# ffmpeg and ffprobe come from npm (ffmpeg-static, ffprobe-static). Set these only
# to use a different build, and check it has libass with HarfBuzz first:
#   ffmpeg -buildconf | grep -E "libass|harfbuzz"
# Without HarfBuzz, Telugu and Devanagari captions render as unjoined letters.
# FFMPEG_PATH=
# FFPROBE_PATH=
#
# Run this after every deploy. No database, no model, no bucket: it renders a
# test video with Telugu captions and checks the result.
#   node scripts/editSelfTest.js

# Where footage lives. SET THIS IN PRODUCTION. With a bucket, browsers upload
# straight to Cloud Storage and nothing passes through nginx or this server.
#
# solosaas-bucket is SHARED with betaFounderProduction, like the Redis node.
# Every object this project writes sits under MEDIA_PREFIX (default "lipi"), and
# the storage layer refuses to delete anything outside it.
#
# Credentials come from the VM (Application Default Credentials), same as the
# other project. Its service account needs Storage Object Admin on the bucket,
# AND "Service Account Token Creator" on itself so it can sign read URLs: the
# editor never makes footage public, it hands out one-hour and twelve-hour links.
#
# Then add our CORS rule and lifecycle backstop, once. It MERGES with the rules
# betaFounderProduction already relies on; run without --apply first to see:
#   node scripts/configureMediaBucket.js
#   node scripts/configureMediaBucket.js --apply
MEDIA_BUCKET=solosaas-bucket
# MEDIA_PREFIX=lipi

# Without MEDIA_BUCKET, files are kept on this server's disk under this folder
# and served by routes/media.js. Fine for development. On a VM, nginx must allow
# 12 MB request bodies under /api/media/ (deploy/nginx.conf does).
# MEDIA_LOCAL_DIR=

# Optional. Without it, local-mode upload and playback links are sent as paths
# ("/media/upload/...") and the browser puts its own REACT_APP_API_URL in front,
# which is right behind nginx's /api prefix. Set it only if the browser must
# reach media at a different address. Not used with MEDIA_BUCKET.
# PUBLIC_API_URL=

# Model that listens to recordings. Needs audio input. Defaults to
# GEMINI_TEXT_MODEL, then GEMINI_VIDEO_MODEL.
# GEMINI_AUDIO_MODEL=

# Credits. Matching is per started minute of RECORDING, export per started minute
# of the FINISHED video. Upload, preview and editing are free.
# EDIT_ANALYSE_CREDITS_PER_MIN=4
# EDIT_EXPORT_CREDITS_PER_MIN=8
# EDIT_TRANSLATE_CREDITS_PER_MIN=1   captions translated, per started minute of speech
# Bigger exports cost more, as multiples of the export price above: 1440p,
# 4K (2160p), and 50/60 fps (which multiplies with either). 720p/1080p at up to
# 30 fps cost the base price. EDIT_EXPORT_MAX_RESOLUTION caps what is offered
# (a small VM takes a long time over 4K).
# EDIT_EXPORT_1440_MULTIPLIER=1.5
# EDIT_EXPORT_4K_MULTIPLIER=2
# EDIT_EXPORT_HIGH_FPS_MULTIPLIER=1.5
# EDIT_EXPORT_MAX_RESOLUTION=2160

# Limits.
# EDIT_MAX_UPLOAD_MB=2048
# EDIT_MAX_RECORDING_SECONDS=1200   total across a project's recordings
# EDIT_MAX_ASSET_SECONDS=900        one B-roll video or music file
# EDIT_MAX_MEDIA=60                 files per project
# EDIT_DAILY_ANALYSES=25
# EDIT_DAILY_EXPORTS=25
# EDIT_DAILY_TRANSLATIONS=40
# EDIT_MAX_PROJECTS=50              live projects per creator

# Days a project's files are kept after it was last touched. Exports included.
# EDIT_RETENTION_DAYS=7

# Jobs one server process runs at once. A 1080p export is CPU-bound: one per
# vCPU pair is a sensible ceiling. Set EDIT_RUNNER_DISABLED=true on an instance
# that should serve requests but never render.
# EDIT_PREPARE_CONCURRENCY=2
# EDIT_ANALYSE_CONCURRENCY=1
# EDIT_RENDER_CONCURRENCY=1
# EDIT_TRANSLATE_CONCURRENCY=2
# EDIT_RUNNER_DISABLED=


# ═══════════════════════════════════════════════════════════════════════════
# DEMO STUDIO  (routes/studio.js, services/studio/*)
#
# The AI screen recorder. Shares the model provider, MEDIA_BUCKET and the credit
# system with everything above; these are only the knobs that are its own.
# ═══════════════════════════════════════════════════════════════════════════

# Which Gemini model reads the frames. Defaults from the provider; see the
# "Which model" block at the top of this file.
# GEMINI_VISION_MODEL=

# Whether the FIRST analysis reads frames with the model, or only the pointer.
#
# Off by default, and that default costs more than it looks. With it off the
# analysis sees no elements at all, which means:
#
#   no control is ever named under a press, so confirmClicks() judges on the
#     pointer alone and a site that draws a plain arrow over a real button
#     loses every zoom it should have had
#   no `video` or `image` region is ever reported, so events.js mediaUnder()
#     cannot refuse a press made inside a demo video playing ON the page — and
#     a recording of a competitor's home page then gets a camera move for every
#     click the stranger in that video made
#
# The second one is the reason to turn this on. A page with a product demo
# playing on it is the single hardest case this product has, and the model is
# the only part of the system that can tell a screen from a picture of a screen.
#
# The cost is the frame grid: at STUDIO_FRAME_EVERY=2 that is one call every two
# seconds of recording, which is most of what an analysis spends. The vision
# pass reads the same frames later anyway, so turning this on moves that cost
# earlier rather than adding it — what it adds is a second read for creators who
# would never have asked for the vision pass at all.
# STUDIO_VISION_ON_ANALYSE=on

# ── THE BLUR PASS, WHICH IS CURRENTLY PAUSED ─────────────────────────────────
# Off. Set to `on` to restore it.
#
# It finds passwords, API keys, card numbers and private email in the frames and
# blurs them, and it is the one pass this pipeline was written to run always:
# a missed API key cannot be un-published, and the creator who most needs it is
# the one who did not think to ask.
#
# It is paused only while the camera and the click detection are being worked
# on, so that the measurements those are judged by are not competing with a
# second model pass for the same quota. The reasoning above has not stopped
# being true, and this has to go back to `on` BEFORE anybody outside the team
# records anything. The editor keeps telling the creator that nothing has been
# checked, which is the only reason pausing it is safe at all.
# STUDIO_BLUR=on

# Seconds between the frames sent for analysis. This is the single biggest
# lever on what an analysis costs: halving it doubles the bill and finds
# slightly tighter step boundaries. Two seconds is where that stopped paying.
# STUDIO_FRAME_EVERY=2

# How many frames one analysis is willing to have in the air. NOT the rate
# limit — that is GEMINI_RPM and GEMINI_CONCURRENCY at the top of this file, and
# they apply across every caller at once. This is only about memory: each frame
# in flight is a base64 JPEG held until the answer comes back.
# STUDIO_VISION_CONCURRENCY=4

# ── The cross-check (services/studio/audit.js) ───────────────────────────────
# After an analysis, the edit is checked against the recording it came from.
# Two frames are cut at each moment the pixel pipeline was unsure about or did
# not account for at all, and the model is asked what actually happened there.
#
# It is not a second click detector. The clicks come from the pointer, and that
# stays the source of truth — a press is a tenth of a second of behaviour and
# the model would need thirty times the frames to see it. This finds what was
# MISSED, which examining the presses that WERE found never can:
#
#     every significant change on screen        (measured, free, no model)
#   - every change an event already explains
#   = the moments worth paying to look at
#
# Cheap by construction: about fifty frames on a ten minute demo, against three
# hundred for the uniform grid the vision pass reads. Nothing it finds is
# applied — camera changes arrive as suggestions the creator accepts one at a
# time, and the only thing written directly is evidence onto the events that
# were checked. It runs inside the `review` job; there is no separate charge.
#
# Its thresholds are the AUDIT block in services/studio/audit.js rather than env
# vars, for the same reason events.js RULES are: they are judgements that get
# re-tuned against real recordings together, not knobs to set per deployment.

# Whether a press the cross-check is SURE about becomes a zoom on its own.
#
# On by default: a demo that silently drops a click the model plainly saw is the
# wrong output. "Sure" is AUDIT.apply (0.8), deliberately higher than the 0.6
# that makes a finding worth offering — those answer different questions. Being
# wrong at 0.6 costs a creator a moment dismissing a suggestion; being wrong
# here costs them a camera move they did not ask for and have to find and
# delete.
#
# Set this to 0 to go back to offering every one of them as a button instead.
# Worth doing on a deployment where the recordings are pages with other
# people's demo videos playing on them, until you have watched the "content"
# verdict work on a few real recordings: the arbiter is asked whether a position
# is inside a picture of another screen BEFORE it is asked anything else, and
# that question is what keeps a stranger's mouse from moving the camera.
# STUDIO_AUTO_PRESS_ZOOMS=1

# Price. Analysing is nearly all model calls and is the expensive half;
# exporting is server time. Recording, uploading and editing are free.
# STUDIO_ANALYSE_CREDITS_PER_MIN=12
# STUDIO_EXPORT_CREDITS_PER_MIN=8
# STUDIO_REVIEW_CREDITS=3

# Export multipliers, against a 1080p30 H.264 export.
# STUDIO_1440_MULTIPLIER=1.5
# STUDIO_2160_MULTIPLIER=2.5
# STUDIO_60FPS_MULTIPLIER=1.6
# STUDIO_BEST_MULTIPLIER=1.3
# STUDIO_HEVC_MULTIPLIER=1.4
# STUDIO_MAX_RESOLUTION=2160

# Limits.
# STUDIO_MAX_UPLOAD_MB=4096
# STUDIO_MAX_RECORDING_SECONDS=1800   thirty minutes
# STUDIO_MAX_DEMOS=60                 live recordings per creator
# STUDIO_DAILY_ANALYSES=25
# STUDIO_DAILY_EXPORTS=40

# Days a recording's files are kept after it was last touched.
# STUDIO_RETENTION_DAYS=7

# Jobs one process runs at once. A render is CPU-bound and also spends a
# canvas thread drawing the cursor layer, so one at a time per box is right
# until there are cores to spare. Set STUDIO_RUNNER_DISABLED=true on an
# instance that should serve requests but never render.
# STUDIO_PREPARE_CONCURRENCY=2
# STUDIO_ANALYSE_CONCURRENCY=1
# STUDIO_CAPTIONS_CONCURRENCY=2
# STUDIO_RENDER_CONCURRENCY=1
# STUDIO_REVIEW_CONCURRENCY=2
# STUDIO_RUNNER_DISABLED=

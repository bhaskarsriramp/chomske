# ── Hinglish frontend config ──────────────────────────────────────────────────
# Copy to .env. CRA only exposes vars prefixed REACT_APP_, and they are baked
# into the build at compile time — so nothing secret ever goes in this file.

# Must be the SAME OAuth client id as GOOGLE_CLIENT_ID in backend/.env, or the
# backend's audience check rejects every login.
REACT_APP_GOOGLE_CLIENT_ID=

# Where the API lives. Local dev: http://localhost:5000
# Production: https://api.chomske.com (or wherever the backend is deployed)
REACT_APP_API_URL=http://localhost:5000

    "build": "react-scripts build",
    "postbuild": "node scripts/prerender.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "inlineCss": true,
    "puppeteerArgs": [
      "--no-sandbox"
    ],
    "crawl": false,
    "include": [
      "/",
      "/pricing",
      "/about-us",
      "/contact",
      "/terms",
      "/privacy-policy",
      "/refund-cancellation-policy",
      "/shipping-policy",
      "/google-api-disclosure",
      "/disclosure-policy",
      "/trust-center",
      "/youtube_api_disclosure",
      "/security",
      "/personalised-user-tone",
      "/schedule-publish",
      "/save-time",
      "/products-affiliate"
    ],
    "waitFor": 2500,
    "skipThirdPartyRequests": true
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "react-snap": {
      "puppeteer": "^13.7.0"
    }
  }
